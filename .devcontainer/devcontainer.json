{
  "name": "dreamscaper",
  "image": "mcr.microsoft.com/devcontainers/rust:1-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends g++ pkg-config libx11-dev libasound2-dev libudev-dev libxkbcommon-x11-0 libvulkan-dev libwayland-dev libxkbcommon-dev lld clang mold xvfb libxcursor-dev libxrandr-dev libxi-dev mesa-vulkan-drivers libgl1-mesa-dri vulkan-tools && rustup update stable && rustup target add wasm32-unknown-unknown",
  // Optional: For native host GUI window & GPU passthrough on Windows (WSL2/WSLg) or Linux,
  // uncomment the runArgs and containerEnv blocks below:
  // "runArgs": [
  //   "--ipc=host",
  //   "--net=host",
  //   "-v", "/tmp/.X11-unix:/tmp/.X11-unix:rw",
  //   "-v", "/mnt/wslg:/mnt/wslg:rw",
  //   "--device", "/dev/dri:/dev/dri"
  // ],
  // "containerEnv": {
  //   "DISPLAY": "${localEnv:DISPLAY}",
  //   "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
  //   "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir"
  // },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "eamodio.gitlens"
      ],
      "settings": {
        "rust-analyzer.checkOnSave.command": "clippy",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  },
  "remoteUser": "vscode"
}
